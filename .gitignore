# --- private / machine-local (never committed) ------------------------------
.venv/
data/
config/*.json
!config/*.sample.json
.env
sessions.local.yaml
/webapp/*
!/webapp/cloudflared.sample.yml
.launcher-tmp/
*.log
# personal rosters and decks: only synthetic fixtures under tests/fixtures/
*.xlsx
!tests/fixtures/**/*.xlsx
*.pptx
!tests/fixtures/**/*.pptx
*.docx
!tests/fixtures/**/*.docx
# session event/log streams (chat.jsonl, events.jsonl, quiz.jsonl): only synthetic fixtures
*.jsonl
!tests/fixtures/**/*.jsonl
# a session's playbook.md lives in its session folder, outside the repo: only synthetic fixtures
playbook.md
!tests/fixtures/**/playbook.md

# --- python / tooling ------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- e2e scratch -------------------------------------------------------------
tests/e2e/_shots/
test-results/

# --- agent noise (AGENTS.md IS committed) -----------------------------------
# .claude/ is private except the reviewed verify skill (docs/agents/project-skills.md)
**/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/verify-facilitation-suite/
.agents/
.codex/
