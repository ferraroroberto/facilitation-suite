{
  "type": "word_cloud",
  "label": "Word cloud",
  "icon": "cloud",
  "order": 1,
  "description": "Every answer grows the cloud live: answers of up to three words stay one phrase (Automatic), each answer stays whole (Verbatim) or every answer is split into words (Words).",
  "chat_prompt_hint": "One or two words: …",
  "options": [
    {
      "key": "terms",
      "label": "How answers become words",
      "kind": "select",
      "default": "auto",
      "choices": [
        [
          "auto",
          "Automatic: short answers whole, long ones split"
        ],
        [
          "verbatim",
          "Verbatim: each answer as typed"
        ],
        [
          "words",
          "Words: every answer split"
        ]
      ]
    },
    {
      "key": "long_answers",
      "label": "Answers longer than three words (Automatic)",
      "kind": "select",
      "default": "split",
      "choices": [
        [
          "split",
          "Split into words"
        ],
        [
          "whole",
          "Keep whole"
        ],
        [
          "keyword",
          "Keep one keyword"
        ]
      ]
    },
    {
      "key": "split_ideas",
      "label": "Split ideas at + , ; / & and line breaks",
      "kind": "switch",
      "default": false
    },
    {
      "key": "split_and",
      "label": "Also split at \"y\", \"e\" and \"and\"",
      "kind": "switch",
      "default": false
    },
    {
      "key": "merge_variants",
      "label": "Merge plurals, accents and case",
      "kind": "switch",
      "default": true
    },
    {
      "key": "merge_near",
      "label": "Merge near-spellings (a typo away)",
      "kind": "switch",
      "default": false
    },
    {
      "key": "stopwords",
      "label": "Ignore filler words",
      "kind": "select",
      "default": "es",
      "choices": [
        [
          "none",
          "Keep everything"
        ],
        [
          "es",
          "Spanish"
        ],
        [
          "en",
          "English"
        ],
        [
          "both",
          "Spanish + English"
        ]
      ]
    },
    {
      "key": "show_names",
      "label": "Show names on stage",
      "kind": "switch",
      "default": false
    }
  ],
  "samples": [
