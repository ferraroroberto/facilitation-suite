%% facilitation-suite — internal structure (hand-authored; update with structural changes)
flowchart LR
  subgraph clients[Browser views]
    appv["/ app<br/>Sessions · Plan · Groups · Results · Settings"]
    presenter["/presenter"]
    stage["/stage (OBS display capture)"]
  end
  tray["tray.bat → app/tray/tray.py"] --> server
  subgraph server[FastAPI :8449 — app/webapp/server.py]
    pages["routers/pages.py<br/>pages · /healthz · /api/version"]
    sessr["routers/sessions.py<br/>/api/sessions…"]
    slidesr["routers/slides.py<br/>import jobs · slides · native picker"]
    actr["routers/activities.py<br/>/api/activities"]
    liver["routers/live.py<br/>WS /ws · /api/live…"]
  end
  liver --> hub["src/live/hub.py<br/>LiveHub — the one live state<br/>position · clocks · item timers"]
  liver --> acts["src/live/actions.py<br/>intent registry"]
  acts --> hub
  hub --> run["src/live/plan.py<br/>run order"]
  hub --> store
  hub --> livefiles[("live/state.json · live/events.jsonl")]
  sessr -->|plan saved| hub
  presenter <-->|WS snapshots / intents| liver
  stage <-->|WS snapshots / intents| liver
  presenter --> themes[("themes/*.css + session theme.css")]
  zoom["Zoom · popped-out Meeting chat"] -->|MSAA walk every 0.5 s| reader["src/chat/reader.py<br/>own process · diff by order · simulator"]
  reader -->|POST /api/chat/messages · heartbeat| chatr["routers/chat.py (loopback only)"]
  chatr --> chathub["src/chat/hub.py<br/>ChatHub · reader state · stale monitor"]
  chathub --> hub
  chathub --> chatfile[("live/chat.jsonl")]
  hub -->|session live| proc["src/chat/process.py<br/>ReaderProcess"]
  proc -.->|spawns| reader
  chathub -->|new messages| capture["src/live/capture.py<br/>CaptureService · windows · hide · freeze"]
  capture --> hub
  capture --> reg
  reg --> parsers[("app/activities/&lt;type&gt;/parse.py · stage.js")]
  capture --> capfiles[("live/captures.json · captures/&lt;item&gt;.json + .png")]
  capture -.->|spawns| freeze["src/live/freeze.py<br/>headless /stage?freeze="]
  parsers -->|map| geo["src/geo/gazetteer.py<br/>offline GeoNames · aliases · suggest"]
  geo --> geodata[("app/activities/map/cities.tsv.gz · countries.json · world.svg")]
  buildgeo["scripts/build_geo.py (network, once)"] -.-> geodata
  stage --> themes
  actr --> reg["src/activities/registry.py"]
  model --> reg
  reg --> plug[("app/activities/&lt;type&gt;/editor.json")]
  slidesr --> importer["src/importer/service.py<br/>ImportJob · plan build · re-import"]
  importer -->|child process| com["src/importer/pptx_com.py<br/>PowerPoint COM export"]
  importer --> analyze["src/importer/analyze.py<br/>dHash · OBS profile"]
  importer --> folder
  sessr --> store["src/sessions/store.py<br/>ledger · folders · session.yaml"]
  store --> model["src/sessions/model.py<br/>Pydantic schema v1"]
  sessr --> offline["src/sessions/offline.py<br/>OneDrive hydration + pin"]
  sessr --> ready["src/sessions/readiness.py"]
  store --> ledger[("sessions.local.yaml")]
  store --> folder[("session folder<br/>session.yaml · slides/ · live/ · exports/")]
  appv --> pages
  appv --> sessr
  appv --> slidesr
  appv --> actr
  presenter --> pages
  stage --> pages
  pages --> cfg["src/config.py<br/>config.json · env overrides"]
  pages --> build["src/build_info.py"]
