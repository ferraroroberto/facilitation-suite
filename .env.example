# Copy this file to `.env` (gitignored) and fill in real values.
# Never commit `.env` or real secrets — see README "Spotify setup".

# Client ID from the Spotify developer dashboard app (no client secret: login uses PKCE)
SPOTIFY_CLIENT_ID=

# Written by `scripts/spotify_login.py` after the browser login — don't set by hand
SPOTIFY_REFRESH_TOKEN=

# Optional: only needed if Spotify shows the desktop app's device under a different name
SPOTIFY_DEVICE_NAME=
